# ASK-AI 2.0 environment template.
#
# Copy to .env and fill in real values. Never commit .env.
# Values marked REQUIRED have no working default; everything else is optional and
# shows the default the code falls back to.
#
# Every variable here is read somewhere in the codebase. Changing one is safe;
# deleting a non-REQUIRED one just restores the default.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
ENVIRONMENT=development               # development | production
APP_VERSION=2.0

# ---------------------------------------------------------------------------
# LLM (answer generation and query rewriting)
# ---------------------------------------------------------------------------
LLM_PROVIDER=groq                     # groq | ollama  (which provider is tried first)
LLM_PROVIDER_ORDER=                   # e.g. groq,ollama - overrides the above when set
LLM_MODEL=openai/gpt-oss-120b         # model for the primary provider
GROQ_API_KEY=                         # REQUIRED when using groq (GROK_API_KEY also accepted)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b              # model for the Ollama fallback
LLM_TIMEOUT_SECONDS=45                # per attempt, so a hung provider fails fast
LLM_MAX_ATTEMPTS=3                    # attempts per provider before falling back
LLM_BACKOFF_BASE_SECONDS=1.5          # exponential backoff base, with jitter
LLM_BACKOFF_CAP_SECONDS=20
LLM_PROVIDER_COOLDOWN_SECONDS=120     # how long a rejected provider stays out of rotation
LLM_RETRY_AFTER_MAX_SECONDS=45        # longest wait for a rate-limit window (0 = never wait)
QUERY_REWRITE_ENABLED=true            # LLM typo normalisation before retrieval
QUERY_REWRITE_MAX_TOKENS=60

# ---------------------------------------------------------------------------
# Pinecone (the retrieval store)
# ---------------------------------------------------------------------------
PINECONE_API_KEY=                     # REQUIRED - index key (vectors)
PINECONE_EMBEDDING_API_KEY=           # REQUIRED - inference key (may be a second account)
PINECONE_INDEX_NAME=ask-ai
EMBEDDING_MODEL=llama-text-embed-v2
EMBEDDING_DIMENSION=1024
EMBEDDING_BACKEND=pinecone            # pinecone | local
LOCAL_EMBEDDING_MODEL=BAAI/bge-large-en-v1.5   # used only when EMBEDDING_BACKEND=local

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
CHUNK_SIZE_CHARS=1500                 # ~375 tokens, inside the 507-token embedding window
CHUNK_OVERLAP_CHARS=200
DENSE_CANDIDATES=40                   # vector candidates per query
LEXICAL_CANDIDATES=40                 # keyword candidates per query
FUSION_CANDIDATES=50                  # fused candidates handed to the reranker
RRF_K=60                              # reciprocal rank fusion constant
RERANK_ENABLED=true
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=50
RERANK_TOP_N=20
RERANK_MAX_CHARS=2000                 # per-candidate text passed to the reranker
NEIGHBOUR_RADIUS=1                    # chunks before/after each selected match
MAX_NEIGHBOUR_DOCS=5
MAX_CONTEXT_CHUNKS=25
NEIGHBOUR_SCORE_DECAY=0.9
HYBRID_SEARCH_ENABLED=true            # false disables keyword search and correction
LEXICAL_DB_PATH=lexical_index.db      # SQLite FTS5 keyword index
LEXICAL_MAX_CORRECTIONS=3             # query tokens corrected per query
LEXICAL_MAX_DISTANCE=2                # edit distance allowed when matching a corpus term
LEXICAL_VOCAB_CANDIDATES=400
INDEX_SCAN_RECOVERY_WORKERS=8          # parallel reads for IDs the fetch endpoint refuses

# ---------------------------------------------------------------------------
# Answer path (API)
# ---------------------------------------------------------------------------
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_SECONDS=3600
ANSWER_CACHE_ONLY_GROUNDED=true       # do not cache answers that cited nothing
ANSWER_CACHE_MAX_ENTRIES=2000         # in-process fallback only
ANSWER_CACHE_PREFIX=askai:answer_cache
ASK_RATE_CAPACITY=30                  # burst of questions per access scope
ASK_RATE_REFILL_PER_SECOND=0.05       # sustained rate (0.05 = three per minute)
PROMPT_CONTEXT_MAX_CHARS=12000        # ceiling on retrieved context in one prompt
                                      # (~3k tokens; raise if your provider tier allows)
CONVERSATION_HISTORY_TURNS=3          # turns replayed into the prompt
CONVERSATION_HISTORY_CHARS=2000
CONVERSATION_MEMORY_TURNS=4           # turns kept per session
CONVERSATION_MEMORY_TTL=7200
CONVERSATION_MEMORY_MAX_SESSIONS=500
CONVERSATION_MEMORY_PREFIX=askai:conversation

# ---------------------------------------------------------------------------
# PostgreSQL (users, chat history, feedback - NOT the document store)
# ---------------------------------------------------------------------------
DATABASE_URL=                         # e.g. postgresql://user:pass@host:5432/askai
VECTOR_DB_URL=                        # pgvector instance, if you keep the legacy tables
REQUIRE_DATABASE=false                # true makes startup fail when the database is down
DOC_EMBEDDING_MODEL=                   # legacy document-level embedding model

# ---------------------------------------------------------------------------
# Redis (Celery broker, dedup ledger, usage tracking, answer cache)
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DEDUP_REDIS_URL=                      # defaults to CELERY_BROKER_URL
DEDUP_REDIS_KEY=askai:dedup:processed_message_ids
CONTENT_DEDUP_PREFIX=askai:content_dedup
CONTENT_DEDUP_STALE_SECONDS=3600      # how long a pending claim blocks a retry
USAGE_TRACKING_ENABLED=true
USAGE_REDIS_KEY=                      # defaults to the built-in usage key

# ---------------------------------------------------------------------------
# Gmail ingestion
# ---------------------------------------------------------------------------
GMAIL_ACCOUNT_IDS=                    # comma-separated mailboxes to watch
GMAIL_CLIENT_SECRETS_FILE=client_secret.json
GMAIL_TOKEN_STORE=tokens/{user_id}.json
GCP_PUBSUB_TOPIC=                     # projects/PROJECT_ID/topics/TOPIC_NAME
GOOGLE_REDIRECT_URI=                  # OAuth callback, must match the Google console
# Pub/Sub push requests are only accepted when they carry a signed OIDC token for
# this audience, from this service account. Both blank = signature not verified.
PUBSUB_OIDC_AUDIENCE=                 # the URL Pub/Sub pushes to (the webhook endpoint)
PUBSUB_OIDC_SERVICE_ACCOUNT=          # the service account email Pub/Sub signs with

# ---------------------------------------------------------------------------
# Retention (deleting email chunks that are no longer used)
# ---------------------------------------------------------------------------
RETENTION_ENABLED=false               # nothing runs until this is true
RETENTION_DRY_RUN=true                # reports only until this is false
RETENTION_DAYS=365
RETENTION_MAX_FRACTION=0.1            # never delete more than this share in one run
RETENTION_QUERY_LIMIT=10000

# ---------------------------------------------------------------------------
# Auth and email delivery
# ---------------------------------------------------------------------------
JWT_SECRET_KEY=                       # REQUIRED - long random value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PII_HASH_SALT=                        # REQUIRED in production - hashes roll numbers and grades
CORS_ALLOW_ORIGINS=*                  # set to your frontend origin before going live
DEFAULT_FROM_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
BREVO_API_KEY=                        # alternative transactional email provider

# ---------------------------------------------------------------------------
# Grievance system (same API process, mounted at /api/grievance)
# ---------------------------------------------------------------------------
# Every grievance setting carries the GRIEVANCE_ prefix so it cannot collide with the
# chatbot's DATABASE_URL, SECRET_KEY or SMTP settings. It keeps its own database on
# purpose: both apps define a `users` table and they are shaped differently.
GRIEVANCE_DATABASE_URL=sqlite:///./grievance.db   # PostgreSQL in production
GRIEVANCE_AUTO_CREATE_TABLES=true                 # dev convenience; use the migrations in production
GRIEVANCE_ENV=development                         # development | production
GRIEVANCE_SECRET_KEY=                             # REQUIRED in production: 32+ random characters
GRIEVANCE_GOOGLE_CLIENT_ID=                       # REQUIRED in production: Google sign-in client id
GRIEVANCE_ALLOWED_EMAIL_DOMAIN=college.edu
GRIEVANCE_DEV_LOGIN_ENABLED=true                  # MUST be false in production
GRIEVANCE_COOKIE_SECURE=false                     # true when served over HTTPS
GRIEVANCE_UPLOAD_DIR=./uploads                    # keep outside anything the web server serves
GRIEVANCE_SMTP_HOST=                              # empty = in-app notifications only
GRIEVANCE_APP_BASE_URL=http://localhost:5173      # links in grievance emails
GRIEVANCE_WORKER_TICK_SECONDS=60                  # escalation / email worker cadence
GRIEVANCE_HINT_CAPACITY=20                        # hint requests per address before refilling
GRIEVANCE_HINT_TIMEOUT_SECONDS=12                 # the form waits 13 seconds
GRIEVANCE_HINT_DENSE_BUDGET_SECONDS=4             # past this, keyword search answers the hint
GRIEVANCE_HINT_MAX_ANSWER_TOKENS=220              # a hint is a paragraph, not an essay

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_FORMAT=json                       # json | text
LOG_LEVEL=INFO
LOG_REQUESTS=true
HEALTH_CACHE_SECONDS=30               # readiness probe cache, so probes do not hit Pinecone
WARMUP_ON_STARTUP=true                # one tiny embedding call at boot, so the first ask is fast

# ---------------------------------------------------------------------------
# Ingestion tooling
# ---------------------------------------------------------------------------
UPLOAD_DIR=storage/uploads
OCR_CACHE_PATH=ocr_cache.json
DEDUP_STORE_PATH=processed_message_ids.json
TESSERACT_CMD=
POPPLER_PATH=
