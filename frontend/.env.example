# API Configuration
# Set your backend API base URL here
VITE_API_BASE_URL=http://localhost:8000/api

# Demo Mode
# Set to 'false' when connecting to a real backend
# Set to 'true' to use mock responses
DEMO_MODE=true

# Grievance form: 'Before you submit: this may help'.
# Leave empty to switch the hint off.
VITE_HINT_URL=/chat/api/ask
